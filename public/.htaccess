# Shared server config for keep-scrolling.com (Hostinger / LiteSpeed).
# Vite copies this file to dist/. The deploy workflow appends the SPA rewrite
# rules for each environment below it.

Options -Indexes
ServerSignature Off

# Never serve dotfiles (.git, .env, .DS_Store, ...) except .well-known.
RedirectMatch 404 /\.(?!well-known/)

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Browsers ignore HSTS over plain HTTP, so this is safe to send always.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Scripts may only come from this site. Media is allowed from any HTTPS host
  # because the Google Sheet decides where images/videos live (R2 today).
  # Data comes from Google Sheets (which redirects to googleusercontent.com)
  # and Sheety. Vimeo is allowed as a frame for any embeds left in the sheet.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; media-src 'self' https:; font-src 'self' data:; connect-src 'self' https://docs.google.com https://*.googleusercontent.com https://api.sheety.co; frame-src https://player.vimeo.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header unset X-Powered-By
</IfModule>

# Caching: hashed build files never change; HTML must always be revalidated so
# a deploy is visible immediately; media is cached for a month.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|mp4|webm|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType image/webp .webp
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>
